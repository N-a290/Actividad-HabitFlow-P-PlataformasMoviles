<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.HabitsTrackerApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/secundary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/neutraldark</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnBackground">@color/black</item>
        <item name="android:background">@color/neutrallight</item>
        <item name="android:fontFamily">@font/plusjakartasans</item>
    </style>

    <style name="Theme.HabitsTrackerApp" parent="Base.Theme.HabitsTrackerApp" />

    <style name="Theme.HabitsTrackerApp.MainActivity">
        <item name="android:fontFamily">@font/nunitosans</item>
        <item name="android:textSize">34sp</item>
    </style>

    <style name="Theme.HabitsTrackerApp.HabitActivity">
        <item name="android:textColor">@color/neutraldark</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Theme.HabitsTrackerApp.HabitListActivity">
        <item name="android:textColor">@color/neutraldark</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">20dp</item>
        <item name="cornerSizeBottomRight">20dp</item>
    </style>
</resources>